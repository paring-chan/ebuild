RUST_MIN_VER="1.95.0"

inherit cargo desktop

V8_VERSION="130.0.7"
V8_TRIPLE="x86_64-unknown-linux-gnu"
V8_ARCHIVE="librusty_v8_release_${V8_TRIPLE}.a.gz"
V8_DISTFILE="rusty_v8-${V8_VERSION}-${V8_TRIPLE}.a.gz"

DESCRIPTION="A modern, lightweight music player built with Rust and Dioxus."
HOMEPAGE="https://github.com/Kopuz-org/kopuz"
SRC_URI="
    https://github.com/Kopuz-org/kopuz/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
    https://github.com/denoland/rusty_v8/releases/download/v${V8_VERSION}/${V8_ARCHIVE} -> ${V8_DISTFILE}
	${CARGO_CRATE_URIS}
"

BDEPEND="
    dev-util/pkgconf
    dev-util/dioxus-cli
"

RDEPEND="
    net-libs/webkit-gtk:4.1
    x11-libs/gtk+:3
    net-libs/libsoup:3.0
    net-libs/glib-networking
    media-libs/alsa-lib
    dev-libs/openssl
    x11-misc/xdotool
    dev-libs/wayland
    sys-apps/dbus
    dev-libs/libayatana-appindicator
    media-libs/opus
    media-libs/gst-plugins-base
    media-libs/gst-plugins-good
    media-libs/gst-plugins-bad
    media-plugins/gst-plugins-libav
"

LICENSE="EUPL-1.2"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD CC0-1.0
	CDLA-Permissive-2.0 ISC LGPL-3+ MIT MPL-2.0 UoI-NCSA Unicode-3.0
	Unlicense ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

QA_PRESTRIPPED="/usr/bin/kopuz"

src_compile() {
    export RUSTY_V8_ARCHIVE="${DISTDIR}/${V8_DISTFILE}"

    dx build --release --platform desktop -p kopuz --offline --frozen || die
}

src_install() {
    dobin target/dx/kopuz/release/linux/app/kopuz

    domenu data/moe.kopuz.kopuz.desktop

    insinto /usr/share/metainfo
    doins data/moe.kopuz.kopuz.metainfo.xml

    newicon -s 256 crates/kopuz/assets/logo.png moe.kopuz.kopuz.png
}
